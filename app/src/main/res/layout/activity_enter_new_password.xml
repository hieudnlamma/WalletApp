<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hues_purple_magnolia">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/_6dp"
                android:paddingEnd="@dimen/_6dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/icn_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sora_semibold"
                    android:text="@string/back"
                    android:textColor="@color/hues_blue_celtic_blue"
                    android:textSize="14sp" />

            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/img_app_name" />

        </androidx.appcompat.widget.Toolbar>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/contentRatioGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.48" />

        <ImageView
            android:id="@+id/imgEnterPassword"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.25"
            android:src="@drawable/icn_page_create_account"
            app:layout_constraintBottom_toTopOf="@id/contentRatioGuideline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutPasswordFormContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/contentRatioGuideline">

            <LinearLayout
                android:id="@+id/passwordFormContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvNewPasswordTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_17sp"
                    android:fontFamily="@font/sora_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/enter_your_new_password"
                    android:textColor="@color/neutrals_black"
                    android:textSize="@dimen/_21sp" />

                <TextView
                    android:id="@+id/tvNewPasswordLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_24dp"
                    android:fontFamily="@font/sora_regular"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.5"
                    android:text="@string/new_password"
                    android:textColor="@color/neutrals_black"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_wallet_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_12dp">

                    <EditText
                        android:id="@+id/edtNewPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/sora_regular"
                        android:hint="@string/enter_new_password"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:paddingStart="0dp"
                        android:paddingEnd="@dimen/_8dp"
                        android:singleLine="true"
                        android:textColor="@color/neutrals_black"
                        android:textColorHint="@color/neutrals_silver_sand"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/ivToggleNewPassword"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/icn_eye_off_line" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvConfirmNewPasswordLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_24dp"
                    android:fontFamily="@font/sora_regular"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.5"
                    android:text="@string/confirm_new_password"
                    android:textColor="@color/neutrals_black"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_wallet_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_12dp">

                    <EditText
                        android:id="@+id/edtConfirmNewPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/sora_regular"
                        android:hint="@string/enter_confirm_new_password"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:paddingStart="0dp"
                        android:paddingEnd="@dimen/_8dp"
                        android:singleLine="true"
                        android:textColor="@color/neutrals_black"
                        android:textColorHint="@color/neutrals_silver_sand"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/ivToggleConfirmNewPassword"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/icn_eye_off_line" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/btnLogin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16dp"
                android:layout_marginBottom="@dimen/_20dp"
                android:background="@drawable/bg_wallet_primary_button"
                android:fontFamily="@font/sora_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingVertical="@dimen/_12dp"
                android:text="@string/done"
                android:textColor="@color/neutrals_white"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
