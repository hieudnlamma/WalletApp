<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/ToolbarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentInsetEnd="0dp"
            app:contentInsetStart="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/icn_back"
                android:drawablePadding="@dimen/_2dp"
                android:fontFamily="@font/sora_semibold"
                android:layout_marginStart="@dimen/_16dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/back"
                android:textColor="@color/hues_blue_celtic_blue"
                android:textSize="@dimen/_14sp" />
        </androidx.appcompat.widget.Toolbar>

        <TextView
            android:id="@+id/tvTransferTo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora_regular"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginTop="@dimen/_24dp"
            android:includeFontPadding="false"
            android:text="@string/transfer_to"
            android:textColor="@color/black"
            android:textSize="@dimen/_24sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <LinearLayout
            android:id="@+id/llNewBills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_40dp"
            android:layout_marginStart="@dimen/_16dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTransferTo">

            <ImageView
                android:id="@+id/imvAdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:src="@drawable/icn_add"/>

            <TextView
                android:id="@+id/tvNewContact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sora_regular"
                android:layout_marginStart="@dimen/_8dp"
                android:layout_gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/new_contact"
                android:textColor="@color/neutrals_black"
                android:textSize="@dimen/_12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llOr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:paddingHorizontal="@dimen/_16dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llNewBills">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:background="@color/neutrals_alice_blue"/>

            <TextView
                android:id="@+id/tvOr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sora_regular"
                android:layout_marginStart="@dimen/_8dp"
                android:layout_gravity="center_vertical"
                android:includeFontPadding="false"
                android:paddingHorizontal="@dimen/_16dp"
                android:text="@string/or"
                android:textColor="@color/neutrals_slate_gray"
                android:textSize="@dimen/_12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:background="@color/neutrals_alice_blue"/>

        </LinearLayout>

        <EditText
            android:id="@+id/edtSearchContact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="@drawable/bg_history_search_field"
            android:paddingVertical="@dimen/_8dp"
            android:paddingHorizontal="@dimen/_12dp"
            android:layout_marginHorizontal="@dimen/_16dp"
            android:layout_marginTop="@dimen/_16dp"
            android:drawableStart="@drawable/icn_search"
            android:drawablePadding="8dp"
            android:fontFamily="@font/sora_regular"
            android:gravity="center_vertical"
            android:hint="@string/search_contact"
            android:imeOptions="actionSearch"
            android:includeFontPadding="false"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/neutrals_black"
            android:textColorHint="@color/neutrals_silver_sand"
            android:textSize="@dimen/_14sp"
            android:lineSpacingMultiplier="1.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llOr"
            tools:text="" />

        <TextView
            android:id="@+id/tvFrequentContacts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora_regular"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginTop="@dimen/_16dp"
            android:layout_gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="@string/frequent_contacts"
            android:textColor="@color/neutrals_black_coral"
            android:textSize="@dimen/_12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edtSearchContact"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvListFrequentContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/_2dp"
            tools:listitem="@layout/item_contract"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:orientation="vertical"
            tools:itemCount="3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFrequentContacts"/>

        <TextView
            android:id="@+id/tvAllContacts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora_regular"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginTop="@dimen/_12dp"
            android:layout_gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="@string/all_contacts"
            android:textColor="@color/neutrals_black_coral"
            android:textSize="@dimen/_12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rcvListFrequentContacts"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvListAllContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/_2dp"
            tools:listitem="@layout/item_contract"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:orientation="vertical"
            tools:itemCount="3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAllContacts"/>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
