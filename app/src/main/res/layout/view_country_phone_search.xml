<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@color/neutrals_white"
    android:paddingHorizontal="8dp"
    android:paddingVertical="8dp">

    <EditText
        android:id="@+id/edtSearchCountry"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_history_search_field"
        android:drawableStart="@drawable/icn_search"
        android:drawablePadding="8dp"
        android:fontFamily="@font/sora_regular"
        android:hint="@string/search_country"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textColor="@color/neutrals_black"
        android:textColorHint="@color/neutrals_silver_sand"
        android:textSize="14sp" />
</FrameLayout>
