<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <ImageView
            android:id="@+id/imvPaymentSuccess"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_126dp"
            android:layout_marginTop="@dimen/_68dp"
            android:src="@drawable/img_payment_success"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPaymentDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora_semibold"
            android:includeFontPadding="false"
            android:layout_marginTop="@dimen/_8dp"
            android:text="@string/payment_done"
            android:textColor="@color/neutrals_black"
            android:textSize="@dimen/_16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imvPaymentSuccess"
            tools:text="@string/payment_done" />

        <TextView
            android:id="@+id/tvTimeJoined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora_regular"
            android:includeFontPadding="false"
            android:textAlignment="center"
            android:layout_marginTop="@dimen/_6dp"
            android:text="@string/bill_payment_has_been_done_successfully"
            android:textColor="@color/neutrals_black_coral"
            android:textSize="@dimen/_12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPaymentDone" />

        <TextView
            android:id="@+id/tvPaymentDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora_semibold"
            android:includeFontPadding="false"
            android:layout_marginTop="@dimen/_81dp"
            android:layout_marginHorizontal="@dimen/_16dp"
            android:text="@string/payment_details"
            android:textColor="@color/neutrals_black"
            android:textSize="@dimen/_14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTimeJoined" />

        <LinearLayout
            android:id="@+id/layoutBiller"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:background="@drawable/bg_history_detail_field"
            android:orientation="vertical"
            android:layout_marginHorizontal="@dimen/_16dp"
            android:paddingHorizontal="@dimen/_16dp"
            android:paddingVertical="@dimen/_12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPaymentDetails">
            <TextView
                android:id="@+id/tvBiller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sora_regular"
                android:includeFontPadding="false"
                android:minHeight="@dimen/_18dp"
                android:textSize="@dimen/_12sp"
                android:textColor="@color/neutrals_slate_gray"
                android:text="@string/today" />
            <TextView
                android:id="@+id/tvValueBiller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sora_semibold"
                android:includeFontPadding="false"
                android:minHeight="@dimen/_18dp"
                android:textSize="@dimen/_12sp"
                android:textColor="@color/neutrals_black_coral"
                tools:text="December 29, 2022 - 12:32" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:background="@drawable/bg_history_detail_field"
            android:orientation="vertical"
            android:layout_marginHorizontal="@dimen/_16dp"
            android:paddingHorizontal="@dimen/_16dp"
            android:paddingVertical="@dimen/_12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutBiller">
            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sora_regular"
                android:includeFontPadding="false"
                android:minHeight="@dimen/_18dp"
                android:textSize="@dimen/_12sp"
                android:textColor="@color/neutrals_slate_gray"
                android:text="@string/today" />
            <TextView
                android:id="@+id/tvValueAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sora_semibold"
                android:includeFontPadding="false"
                android:minHeight="@dimen/_18dp"
                android:textSize="@dimen/_12sp"
                android:textColor="@color/neutrals_black_coral"
                tools:text="December 29, 2022 - 12:32" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutTransactionNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:background="@drawable/bg_history_detail_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginHorizontal="@dimen/_16dp"
            android:paddingStart="@dimen/_16dp"
            android:paddingEnd="@dimen/_4dp"
            android:paddingVertical="@dimen/_6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutAmount">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sora_regular"
                    android:includeFontPadding="false"
                    android:minHeight="@dimen/_18dp"
                    android:textSize="@dimen/_12sp"
                    android:textColor="@color/neutrals_slate_gray"
                    android:text="@string/transaction_no" />

                <TextView
                    android:id="@+id/tvTransactionNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sora_semibold"
                    android:includeFontPadding="false"
                    android:minHeight="@dimen/_18dp"
                    android:textSize="@dimen/_12sp"
                    android:textColor="@color/neutrals_black_coral"
                    tools:text="23010412432431" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnCopyTransaction"
                android:layout_width="@dimen/_48dp"
                android:layout_height="@dimen/_48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/_12dp"
                android:contentDescription="@string/copy_transaction_number"
                app:srcCompat="@drawable/icn_copy_transaction" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvReportProblem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:background="?attr/selectableItemBackground"
            android:drawableStart="@drawable/icn_red_flag"
            android:drawablePadding="@dimen/_2dp"
            android:fontFamily="@font/sora_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/report_a_problem"
            android:textColor="@color/hues_red_golden_gate_bridge"
            android:textSize="@dimen/_14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutTransactionNumber" />

        <TextView
            android:id="@+id/btnBackToWallet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_20dp"
            android:background="@drawable/bg_wallet_primary_button"
            android:fontFamily="@font/sora_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingVertical="@dimen/_12dp"
            android:layout_marginHorizontal="@dimen/_16dp"
            android:text="@string/back_to_wallet"
            android:lineSpacingMultiplier="1.5"
            android:textColor="@color/neutrals_white"
            android:textSize="@dimen/_14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
