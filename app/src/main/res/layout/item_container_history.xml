<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/layoutItemContainerHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/_24dp"/>

        <TextView
            android:id="@+id/tvWeekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="18dp"
            android:fontFamily="@font/sora_regular"
            android:layout_marginBottom="@dimen/_4dp"
            android:paddingHorizontal="@dimen/_16dp"
            android:includeFontPadding="false"
            android:text="@string/today"
            android:visibility="gone"
            android:textColor="@color/neutrals_slate_gray"
            android:textSize="@dimen/_12sp" />

        <TextView
            android:id="@+id/tvDatetime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="18dp"
            android:paddingHorizontal="@dimen/_16dp"
            android:fontFamily="@font/sora_regular"
            android:includeFontPadding="false"
            android:text="@string/today"
            android:textColor="@color/neutrals_black_coral"
            android:textSize="@dimen/_16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvListTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginVertical="@dimen/_12dp"
            tools:itemCount="3"
            tools:listitem="@layout/item_transaction"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:orientation="vertical"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_6dp"
            android:background="@color/neutrals_alice_blue"/>
    </LinearLayout>
</layout>
