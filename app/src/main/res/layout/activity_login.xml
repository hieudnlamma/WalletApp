<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hues_purple_magnolia">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/img_app_name" />
        </androidx.appcompat.widget.Toolbar>

        <ImageView
            android:id="@+id/imgLogin"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/icn_page_login"
            app:layout_constraintBottom_toTopOf="@id/loginFormContainer"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.25"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <LinearLayout
            android:id="@+id/loginFormContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_16dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvLoginTitle"
                android:layout_width="179dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_17sp"
                android:fontFamily="@font/sora_semibold"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/enter_your_mobile_number"
                android:textColor="@color/neutrals_black"
                android:textSize="@dimen/_21sp"
                />

            <TextView
                android:id="@+id/tvMobileNumberLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_24dp"
                android:fontFamily="@font/sora_regular"
                android:includeFontPadding="false"
                android:text="@string/mobile_number"
                android:textColor="@color/neutrals_black"
                android:textSize="12sp" />

            <com.lmt.global.base.view.custom.PhoneNumberInputView
                android:id="@+id/mobileInputContainer"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvCreateAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/_16dp"
                android:fontFamily="@font/sora_semibold"
                android:includeFontPadding="false"
                android:text="@string/create_account"
                android:textColor="@color/hues_blue_celtic_blue"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:background="@drawable/bg_wallet_primary_button"
                android:fontFamily="@font/sora_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingVertical="@dimen/_12dp"
                android:text="Continue"
                android:textColor="@color/neutrals_white"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:id="@+id/socialDivider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/neutrals_alice_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:fontFamily="@font/sora_regular"
                    android:includeFontPadding="false"
                    android:text="@string/or_continue_using"
                    android:textColor="@color/neutrals_slate_gray"
                    android:textSize="12sp"
                    tools:ignore="HardcodedText" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/neutrals_alice_blue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/socialLoginContainer"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="@dimen/_24dp"
                android:layout_marginBottom="@dimen/_24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnFacebookLogin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_wallet_social_button"
                    android:contentDescription="@null"
                    android:paddingVertical="@dimen/_11dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/icn_facebook" />

                <ImageView
                    android:id="@+id/btnGoogleLogin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_16dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_wallet_social_button"
                    android:contentDescription="@null"
                    android:paddingVertical="@dimen/_11dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/icn_google" />

                <ImageView
                    android:id="@+id/btnAppleLogin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_wallet_social_button"
                    android:contentDescription="@null"
                    android:paddingVertical="@dimen/_11dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/icn_apple" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
