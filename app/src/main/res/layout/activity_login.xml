<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hues_purple_magnolia">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/img_app_name" />
        </androidx.appcompat.widget.Toolbar>

        <ImageView
            android:id="@+id/imgLogin"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_190dp"
            android:layout_marginTop="@dimen/_48dp"
            android:contentDescription="@null"
            android:src="@drawable/icn_page_login"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/loginScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:layout_marginTop="@dimen/_71dp"
            app:layout_constraintTop_toBottomOf="@id/imgLogin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/loginFormContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:paddingHorizontal="@dimen/_16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLoginTitle"
                    android:layout_width="179dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sora_semibold"
                    android:includeFontPadding="false"
                    android:layout_marginTop="@dimen/_17sp"
                    android:lineSpacingMultiplier="1.5"
                    android:text="Enter your mobile number"
                    android:textColor="@color/neutrals_black"
                    android:textSize="@dimen/_21sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvMobileNumberLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_24dp"
                    android:fontFamily="@font/sora_regular"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.5"
                    android:text="@string/mobile_number"
                    android:textColor="@color/neutrals_black"
                    android:textSize="12sp"
                    tools:ignore="HardcodedText" />

                <LinearLayout
                    android:id="@+id/mobileInputContainer"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_wallet_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/viewJordanFlag"
                        android:layout_width="28dp"
                        android:layout_height="21dp"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_jordan_flag" />

                    <TextView
                        android:id="@+id/tvCountryCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_regular"
                        android:layout_marginStart="@dimen/_8dp"
                        android:includeFontPadding="false"
                        android:text="+962"
                        android:textColor="@color/neutrals_black"
                        android:textSize="14sp"
                        tools:ignore="HardcodedText" />

                    <ImageView
                        android:id="@+id/ivCountryDropdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@null"
                        android:src="@drawable/icn_arrow_drop_down_line" />

                    <EditText
                        android:id="@+id/edtMobileNumber"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/sora_regular"
                        android:hint="7X-XXXXXXX"
                        android:importantForAutofill="yes"
                        android:inputType="phone"
                        android:paddingStart="8dp"
                        android:paddingEnd="0dp"
                        android:singleLine="true"
                        android:textColor="@color/neutrals_black"
                        android:textColorHint="@color/neutrals_silver_sand"
                        android:textSize="14sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCreateAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/_16dp"
                    android:fontFamily="@font/sora_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/create_account"
                    android:textColor="@color/hues_blue_celtic_blue"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnContinue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:background="@drawable/bg_wallet_primary_button"
                    android:fontFamily="@font/sora_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingVertical="@dimen/_12dp"
                    android:text="Continue"
                    android:textColor="@color/neutrals_white"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />

                <LinearLayout
                    android:id="@+id/socialDivider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/neutrals_alice_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:fontFamily="@font/sora_regular"
                        android:includeFontPadding="false"
                        android:text="@string/or_continue_using"
                        android:textColor="@color/neutrals_slate_gray"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/neutrals_alice_blue" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/socialLoginContainer"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="@dimen/_24dp"
                    android:layout_marginBottom="@dimen/_24dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnFacebookLogin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/_11dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_wallet_social_button"
                        android:src="@drawable/icn_facebook"
                        android:scaleType="centerInside" />

                    <ImageView
                        android:id="@+id/btnGoogleLogin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/_11dp"
                        android:layout_marginHorizontal="@dimen/_16dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_wallet_social_button"
                        android:src="@drawable/icn_google"
                        android:scaleType="centerInside" />

                    <ImageView
                        android:id="@+id/btnAppleLogin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/_11dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_wallet_social_button"
                        android:src="@drawable/icn_apple"
                        android:scaleType="centerInside" />
                </LinearLayout>
            </LinearLayout>

        </androidx.core.widget.NestedScrollView>



    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
